# Non-secret deployment metadata. Copy to .env on the VPS and chmod 600.
# Production credentials must be added on the VPS/approved secret manager and never committed.

APP_SLUG=customer-a
APP_IMAGE=ghcr.io/example/customer-a:REPLACE_WITH_COMMIT_SHA
HOST_PORT=3101
MEMORY_LIMIT=768m
CPU_LIMIT=1.0

# Application configuration examples:
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# SERVER-ONLY SECRETS: add only to the server-side .env, never to this file.
# SUPABASE_SECRET_KEY=
# RESEND_API_KEY=
# CRON_SECRET=
